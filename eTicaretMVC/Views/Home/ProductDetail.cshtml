@{
    ViewData["Title"] = "Ürün Detayı";
}

<section class="product-detail spad">
    <div class="container">
        <div class="row">
            <div class="col-lg-6">
                <div class="product__details__pic">
                    <img src="~/img/product/product-detail.jpg" alt="Ürün Görseli">
                </div>
            </div>
            <div class="col-lg-6">
                <div class="product__details__text">
                    <h3>Ürün Adı</h3>
                    <h4>150.00 TL</h4>
                    <p>Bu alanda ürün açıklaması yer alacak.</p>
                    <a href="/Cart/AddProduct" class="primary-btn">Sepete Ekle</a>
                </div>
            </div>
        </div>
    </div>
</section>
