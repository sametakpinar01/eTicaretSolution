@{
    ViewData["Title"] = "Anasayfa";
}

<!-- Hero Section Begin -->
<section class="hero">
    <div class="container">
        <div class="row">
            <div class="col-lg-3">
                <div class="hero__categories">
                    <div class="hero__categories__all">
                        <i class="fa fa-bars"></i>
                        <span>Tüm Kategoriler</span>
                    </div>
                    <ul>
                        <li><a href="#">Elektronik</a></li>
                        <li><a href="#">Giyim</a></li>
                        <li><a href="#">Ev & Bahçe</a></li>
                        <li><a href="#">Spor</a></li>
                    </ul>
                </div>
            </div>
            <div class="col-lg-9">
                <div class="hero__search">
                    <div class="hero__search__form">
                        <form action="#">
                            <input type="text" placeholder="Ne arıyorsunuz?">
                            <button type="submit" class="site-btn">ARA</button>
                        </form>
                    </div>
                </div>
                <div class="hero__item set-bg" data-setbg="~/img/hero/banner.jpg">
                    <div class="hero__text">
                        <span>YENİ ÜRÜNLER</span>
                        <h2>En İyi Fırsatlar <br />Sizi Bekliyor!</h2>
                        <p>Ücretsiz Kargo ve Hızlı Teslimat</p>
                        <a href="/Home/Listing" class="primary-btn">Şimdi Alışveriş Yap</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
<!-- Hero Section End -->
<!-- Featured Section Begin -->
<section class="featured spad">
    <div class="container">
        <div class="row">
            <div class="col-lg-12">
                <div class="section-title">
                    <h2>Öne Çıkan Ürünler</h2>
                </div>
            </div>
        </div>
        <div class="row featured__filter">
            <div class="col-lg-3 col-md-4 col-sm-6 mix electronics">
                <div class="featured__item">
                    <div class="featured__item__pic set-bg" data-setbg="~/img/featured/feature-1.jpg">
                        <ul class="featured__item__pic__hover">
                            <li><a href="#"><i class="fa fa-heart"></i></a></li>
                            <li><a href="#"><i class="fa fa-retweet"></i></a></li>
                            <li><a href="/Cart/AddProduct"><i class="fa fa-shopping-cart"></i></a></li>
                        </ul>
                    </div>
                    <div class="featured__item__text">
                        <h6><a href="/Home/ProductDetail">Örnek Ürün 1</a></h6>
                        <h5>150.00 TL</h5>
                    </div>
                </div>
            </div>
            <!-- Daha fazla ürün için benzer yapılar eklenebilir -->
        </div>
    </div>
</section>
<!-- Featured Section End -->